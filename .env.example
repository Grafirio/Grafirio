# Grafirio ortam degiskenleri — kopyala: cp .env.example .env
# Gercek degerleri ASLA commit etme.

MONGO_USERNAME=grifirio_admin
MONGO_PASSWORD=change-me
REDIS_PASSWORD=change-me
REDIS_UI_USERNAME=grifirio_admin
REDIS_UI_PASSWORD=change-me
SA_PASSWORD=change-me
KEYCLOAK_ADMIN=grifirio_admin
KEYCLOAK_ADMIN_PASSWORD=change-me
POSTGRES_DB=keycloak_db
POSTGRES_USER=keycloak_db_user
POSTGRES_PASSWORD=change-me
# DataAnalysis.Api'nin Postgres'i. Mevcut volume ilk olusturuldugu paroladan
# degismez: var olan bir kurulumda eski degeri aynen yazin.
DATAANALYSIS_DB_PASSWORD=change-me
RABBITMQ_USER=grifirio_admin
RABBITMQ_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me
AI_SERVICE_2_URL=http://pycaret.engine:8002

# LLM: tek saglayici Azure OpenAI.
# Gemini kaldirildi. Onceden LLM_PROVIDER ile secim yapiliyordu ve varsayilan
# 'gemini' idi; ortam degiskeni appsettings.json'i ezdigi icin ayni kod
# container'da Gemini'ye, IDE'den Azure'a gidiyordu.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Faz 3: LLM SQL yolunun salt-okunur DB kullanicisi
MSSQL_READONLY_PASSWORD=change-me

# Musteri veritabani sifrelerini koruyan AES anahtari (en az 16 karakter).
# Tanimsizsa DataAnalysis.Api acilista durur — anahtarsiz calismak, sifreleri
# herkesin bildigi bir varsayilanla korumak demekti ve bu sessizce oluyordu.
# Anahtar rotasyonunda eskisini ENCRYPTION_KEY_PREVIOUS'a koyun.
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# PyCaret'in veri okudugu ic ucun (/internal/data/query) paylasilan anahtari.
# Tanimsizsa uc kapalidir: ic aga erisen herkese musteri veritabaninda sorgu
# calistirma yetkisi vermektense hicbir seyin calismamasi tercih edildi.
INTERNAL_API_KEY=

# Ops agent (projectadmin/api): host uzerinde calisir, Docker kapaliyken bile
# altyapiyi izler ve kaldirir. Bu dosyadaki diger degiskenleri de okur.
# Kurtarma anahtari: /recovery ekrani icin (yalnizca bu bilgisayardan). Tanimsizsa ekran kapali.
OPS_RECOVERY_KEY=
# Virgulle ayrilmis, panelin acildigi adresler (CORS).
OPS_ALLOWED_ORIGINS=http://localhost:59265,http://localhost:59666
# Gateway Docker icinde calisiyorsa 0.0.0.0 yapin (varsayilan yalnizca 127.0.0.1).
# OPS_BIND_HOST=0.0.0.0
# E-posta uyarilari: uc degisken de doluysa aktif olur.
OPS_SMTP_HOST=
OPS_SMTP_PORT=587
OPS_SMTP_USER=
OPS_SMTP_PASSWORD=
OPS_SMTP_FROM=
OPS_ALERT_RECIPIENTS=
