<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mikro-benchmark'lar (BenchmarkDotNet). Sicak yollar: SQL politika
    dogrulamasi (her sorguda, hem bulutta hem bridge'de), tel kodlayicilari
    (her satir) ve sozluk birlestirme (her "Analiz Et").

    Calistirma ve dashboard'a gonderme: docs/olcum/README.md ("Mikro-benchmark").
    Release derlemesi sart.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet optimize edilmemis derlemeyi reddediyor. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\shared\Grafirio.QueryPolicy\Grafirio.QueryPolicy.csproj" />
    <ProjectReference Include="..\..\src\bridge\Grafirio.Bridge.Contracts\Grafirio.Bridge.Contracts.csproj" />
    <ProjectReference Include="..\..\src\services\Grafirio.DataAnalysis.Api\Grafirio.DataAnalysis.Api.csproj" />
  </ItemGroup>

</Project>
