<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.1" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="MongoDB.EntityFrameworkCore" Version="8.2.1" />
    <!-- Belge önizlemesi. PDFtoImage PDF'in ilk sayfasını raster'lıyor,
         beraberinde gelen SkiaSharp küçültmeyi yapıyor; ikinci bir görüntü
         kütüphanesi gerekmiyor. NativeAssets paketi olmadan Linux container'da
         SkiaSharp yüklenemiyor. -->
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grafirio.Shared.Infrastructure" Version="1.0.0" />
    <PackageReference Include="Grafirio.Shared.Identity" Version="1.0.0" />
    <PackageReference Include="Grafirio.Contracts.Commerce" Version="1.0.0" />
  </ItemGroup>

</Project>
