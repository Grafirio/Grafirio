{
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/identity/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/api/{version}/{**catch-all}" } ],
        "AuthorizationPolicy": "Password"
      },
      "basket-route": {
        "ClusterId": "basket.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/baskets/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/api/{version}/baskets/{**catch-all}" } ],
        "AuthorizationPolicy": "Password"
      },
      "catalog-route": {
        "ClusterId": "catalog.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/catalogs/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/api/{version}/{**catch-all}" } ],
        "AuthorizationPolicy": "ClientCredential"
      },
      "discount-route": {
        "ClusterId": "discount.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/discounts/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/api/{version}/discounts/{**catch-all}" } ],
        "AuthorizationPolicy": "Password"
      },
      "file-route": {
        "ClusterId": "file.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/files/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/api/{version}/files/{**catch-all}" } ],
        "AuthorizationPolicy": "ClientCredential"
      },
      "order-route": {
        "ClusterId": "order.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/orders/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/api/{version}/orders/{**catch-all}" } ],
        "AuthorizationPolicy": "Password"
      },
      "payment-route": {
        "ClusterId": "payment.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/payments/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "/api/{version}/payments/{**catch-all}" } ],
        "AuthorizationPolicy": "Password"
      },
      "data-analysis-route": {
        "ClusterId": "data-analysis.cluster",
        "Match": {
          "Path": "data-analysis/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      },
      "health-route": {
        "ClusterId": "health.cluster",
        "Match": {
          "Path": "health/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-api.internal.proudcoast-6064711b.westeurope.azurecontainerapps.io"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "basket.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://basket-api.internal.proudcoast-6064711b.westeurope.azurecontainerapps.io"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "catalog.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog-api.internal.proudcoast-6064711b.westeurope.azurecontainerapps.io"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "discount.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "file.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5204"
          }
        }
      },
      "order.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5231"
          }
        }
      },
      "payment.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5029"
          }
        }
      },
      "data-analysis.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://data-analysis-api.internal.proudcoast-6064711b.westeurope.azurecontainerapps.io"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "health.cluster": {
        "Destinations": {
          "gateway": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  },
  "IdentityOption": {
    "Address": "https://keycloak.proudcoast-6064711b.westeurope.azurecontainerapps.io/realms/grafirio",
    "Issuer": "https://keycloak.proudcoast-6064711b.westeurope.azurecontainerapps.io/realms/grafirio",
    "Audience": "gateway.api"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
