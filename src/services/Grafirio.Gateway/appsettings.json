{
  "Cors": {
    "AllowedOrigins": [
      "https://admin.grafirio.com",
      "https://manager.grafirio.com",
      "https://grafirio.com",
      "https://useradmin.proudcoast-6064711b.westeurope.azurecontainerapps.io",
      "https://projectadmin.proudcoast-6064711b.westeurope.azurecontainerapps.io",
      "https://frontend.proudcoast-6064711b.westeurope.azurecontainerapps.io",
      "http://localhost:5173",
      "http://localhost:59264",
      "http://localhost:59265"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "basket-route": {
        "ClusterId": "commerce.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/baskets/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/baskets/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "catalog-route": {
        "ClusterId": "commerce.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/catalogs/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/catalogs/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "categories-route": {
        "ClusterId": "commerce.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/categories/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/categories/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "discount-route": {
        "ClusterId": "commerce.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/discounts/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/discounts/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "file-route": {
        "ClusterId": "commerce.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/files/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/files/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "order-route": {
        "ClusterId": "commerce.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/orders/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "payment-route": {
        "ClusterId": "commerce.cluster",
        "Match": {
          "Path": "{version:regex(^v[0-9]+$)}/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{version}/payments/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "data-analysis-route": {
        "ClusterId": "data-analysis.cluster",
        "Match": {
          "Path": "data-analysis/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "Password"
      },
      "bridge-hub-route": {
        "ClusterId": "data-analysis.cluster",
        "Match": {
          "Path": "/hubs/bridge/{**catch-all}"
        },
        "AuthorizationPolicy": "Anonymous"
      },
      "bridge-installer-route": {
        "ClusterId": "data-analysis.cluster",
        "Match": {
          "Path": "/api/bridges/installer/{**catch-all}"
        },
        "AuthorizationPolicy": "Password"
      },
      "bridge-enroll-route": {
        "ClusterId": "data-analysis.cluster",
        "Match": {
          "Path": "/api/bridges/enroll"
        },
        "AuthorizationPolicy": "Password"
      },
      "health-route": {
        "ClusterId": "health.cluster",
        "Match": {
          "Path": "health/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-api.internal.proudcoast-6064711b.westeurope.azurecontainerapps.io"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "commerce.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://commerce-api.internal.proudcoast-6064711b.westeurope.azurecontainerapps.io"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "data-analysis.cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://data-analysis-api.internal.proudcoast-6064711b.westeurope.azurecontainerapps.io"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "health.cluster": {
        "Destinations": {
          "gateway": {
            "Address": "http://localhost:5000"
          }
        }
      }
    }
  },
  "IdentityOption": {
    "Address": "https://login.grafirio.com/realms/grafirio",
    "Issuer": "https://login.grafirio.com/realms/grafirio",
    "Audience": "gateway.api"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
