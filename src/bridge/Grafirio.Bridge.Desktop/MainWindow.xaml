<Window x:Class="Grafirio.Bridge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Grafirio"
        Width="1180" Height="780"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource Canvas}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <!--
          Giris ekrani: logo ve tek bir dugme. Baska hicbir sey yok — kurulum
          kodu, durum karti, baglanti listesi hepsi kalkti. Kullanicinin bu
          ekranda verecegi tek karar var, o da girmek.
        -->
        <Grid x:Name="LoginView">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{StaticResource BrandMark}" Width="88" Height="88"
                       HorizontalAlignment="Center" />

                <Button x:Name="SignInButton"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,28,0,0" Padding="44,14" FontSize="15"
                        HorizontalAlignment="Center"
                        Content="Giriş Yap"
                        Click="SignInButton_Click" />

                <TextBlock x:Name="LoginHint"
                           Margin="0,18,0,0" MaxWidth="360"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource Muted}"
                           Visibility="Collapsed" />

                <!--
                  Varsayilan olarak kapali: normal akista kimsenin gunluk
                  okumasi gerekmiyor. Hata olunca kendiliginden aciliyor —
                  onceki surumde "Giriş tamamlanamadı"dan baska hicbir sey
                  yazmiyordu ve sebep ekranda hic gorunmuyordu.
                -->
                <Expander x:Name="DetailsPanel"
                          Margin="0,22,0,0" MaxWidth="620"
                          HorizontalAlignment="Center"
                          FontSize="11"
                          Foreground="{StaticResource Muted}"
                          Header="Ayrıntılar">
                    <Border Margin="0,8,0,0" Padding="10" CornerRadius="6"
                            Background="#0f1720">
                        <ScrollViewer x:Name="LogScroller" Height="150"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#cbd5e1" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Expander>
            </StackPanel>
        </Grid>

        <!--
          Girisden sonrasi: panelin kendisi. Yeniden yazilmadi, gomuldu —
          yazilsaydi "web'dekiyle ayni" olmasi ilk degisiklige kadar surerdi.
        -->
        <wv2:WebView2 x:Name="Panel" Visibility="Collapsed" />
    </Grid>
</Window>
