<Window x:Class="Grafirio.Bridge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grafirio" Width="1280" Height="850" MinWidth="1000" MinHeight="680"
        Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="CloudContent" />
        <Border x:Name="NoticeBar" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource Surface}" Padding="18,10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SignInButton" Content="Giriş Yap" Visibility="Collapsed" Click="SignInButton_Click" Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="CancelLoginButton" Content="İptal" Visibility="Collapsed" Click="CancelLoginButton_Click" Margin="8,0,0,0" Style="{StaticResource QuietButton}" />
                    <Button x:Name="RetryButton" Content="Yeniden dene" Visibility="Collapsed" Style="{StaticResource QuietButton}" Click="RetryButton_Click" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>