<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <UseWPF>true</UseWPF>
    <!--
      Tepsi simgesi icin. WPF'in kendi NotifyIcon'u yok; Windows Forms'unki
      isletim sisteminin standart davranisini veriyor ve ek bir bagimlilik
      getirmiyor.
    -->
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      Musteri makinesine tek dosya kuruluyor: .NET runtime kurmak BT
      ekiplerinde ayri bir onay sureci. Konsol surumuyle ayni tercih.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!--
      WPF'in yerel kutuphaneleri (wpfgfx, PresentationNative, D3DCompiler)
      varsayilan olarak exe'nin YANINA dusuyor ve "tek dosya" sozu orada
      bozuluyor: kullanicinin tasimasi gereken bir klasor kaliyor.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Musteriye indirilen dosya bu — boyut aciliş suresinden daha cok onemli.
      WPF kirpma (trimming) desteklemiyor, yani tek kazanc burada.
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <InvariantGlobalization>false</InvariantGlobalization>

    <AssemblyName>GrafirioBridge.Desktop</AssemblyName>
    <RootNamespace>Grafirio.Bridge.Desktop</RootNamespace>
    <Version>1.0.0</Version>

    <!--
      Dosyanin Explorer'da ve gorev cubugunda gordugu ikon. Calisma aninda
      ayarlanan pencere/tepsi ikonu bunun yerine gecmiyor: o ikon yalnizca
      uygulama acikken gecerli, indirilen dosya ise varsayilan Windows
      ikonuyla goruntuleniyordu.

      Kaynak Assets/generate-icon.ps1 — logo degisirse onu yeniden calistirin.
    -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!--
      Dosya meta verisi. SmartScreen uyarisini kaldirmiyor (onu yalnizca kod
      imzalama ve zamanla biriken itibar kaldiriyor) ama uyarinin "Daha fazla
      bilgi" ekranindaki yayinci satirini dolduruyor. Bos birakildiginda
      musterinin BT ekibi hicbir ad goremiyordu.
    -->
    <Company>Grafirio</Company>
    <Product>Grafirio</Product>
    <AssemblyTitle>Grafirio</AssemblyTitle>
    <Description>Grafirio — veritabanınıza kendi ağınızdan bağlanan masaüstü uygulaması</Description>
    <Copyright>© 2026 Grafirio</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Yapilandirma dosyasi cekirdek projeden geliyor: iki kabuk ayni
      appsettings.json semasini okuyor ve ikinci bir kopya tutmak, alanlar
      ayrisinca sessizce bozulan bir esleme demek olurdu. Cekirdegin dosyasi
      referans zinciriyle bu projenin ciktisina da kopyalaniyor.
    -->
    <ProjectReference Include="..\Grafirio.Bridge\Grafirio.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grafirio.Bridge.Desktop.Tests" />
  </ItemGroup>

</Project>
