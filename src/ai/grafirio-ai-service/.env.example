# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,django-ai

# Database (Opsiyonel - SQLite kullanılabilir)
DATABASE_URL=sqlite:///db.sqlite3

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest123

# Celery Configuration
CELERY_BROKER_URL=amqp://guest:guest123@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Redis (WebSocket & Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password123

# AI Service Configuration
AI_SERVICE_1_URL=http://localhost:8001
AI_SERVICE_2_URL=http://localhost:8002

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
