# Gemini API (ücretsiz tier - https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq.container
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest123

# Backend API
BACKEND_API_URL=http://data-analysis.api.container:5221

# Logging
LOG_LEVEL=INFO
