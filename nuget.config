<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="grafirio" value="https://nuget.pkg.github.com/Grafirio/index.json" />
  </packageSources>
  <!--
    Local development: credentials for the "grafirio" source are configured
    per-machine in the user-level NuGet.Config (%APPDATA%\NuGet\NuGet.Config)
    via "dotnet nuget add source". Do not add packageSourceCredentials here
    to avoid committing secrets.

    Docker / CI builds: pass GITHUB_PACKAGES_USER and GITHUB_PACKAGES_TOKEN
    as build args; the Dockerfile injects them into its own copy of this
    file via "dotnet nuget update source" before restoring.
  -->
</configuration>
