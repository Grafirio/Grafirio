<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="grafirio" value="https://nuget.pkg.github.com/Grafirio/index.json" />
    <add key="local-packages" value="C:\yol\local-packages" />
  </packageSources>
  <!--
    Local development: credentials for the "grafirio" source are configured
    per-machine in the user-level NuGet.Config (%APPDATA%\NuGet\NuGet.Config)
    via "dotnet nuget add source". Do not add packageSourceCredentials here
    to avoid committing secrets.

    Docker / CI builds: no credentials are involved. GitHub Packages asks for
    authentication even for public packages, and no identity could be made to
    work from Actions, so the .NET Dockerfiles fetch github.com/Grafirio/Packages
    (a public repository), pack the libraries from source and restore from that
    local folder. The "grafirio" source below stays for local development.
  -->
</configuration>
