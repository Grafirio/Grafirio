<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="grafirio" value="https://nuget.pkg.github.com/Grafirio/index.json" />
  </packageSources>
  <!--
    Credentials for the "grafirio" source are configured per-machine in the
    user-level NuGet.Config (%APPDATA%\NuGet\NuGet.Config) via "dotnet nuget add source".
    Do not add packageSourceCredentials here to avoid committing secrets.
  -->
</configuration>
