// Altin veri: lojistik (zor). Alan aciklamalari icin eticaret/gold.json'a bakin.
//
// Iliski siniflari ve bugunku algoritmadan beklenen:
//   name        ad kokuyle birebir: ExportReferenceId -> L_INT_ExportReference   (bulunmali)
//   name-role   rol onekli: ShipperCompanyId -> L_DEF_Company                    (bulunmali)
//   typo        yazim hatasi: PostionId -> ...Position                           (bulunmali, onay isteyerek)
//   abbreviation kisaltma: ExportRefNo -> ReferenceNo                            (bugun kacar)
//   language    farkli dil: ParaBirimi -> L_DEF_Currency                         (bugun kacar)
//   self        oz-referans, FK yok: ParentCompanyId                             (bilincli olarak atlaniyor)
//   lookup      kosullu parametre: TransportModeCode -> L_DEF_Parameter(TRN)     (tek kolonla ifade edilemez)
//
// nonRelationships: kurulmamasi gereken, ama ad + deger ortusmesiyle kurulmaya
// cok musait baglantilar. Kurulursa precision duser ve join'ler yanlis sonuc verir.
{
  "dataset": "lojistik",
  "description": "FK'siz, onekli, karisik dilli lojistik semasi; kesif algoritmasinin sinirlarini olcer.",
  "tables": {
    "dbo.L_DEF_Country": { "concepts": ["ülke", "ulke", "country"] },
